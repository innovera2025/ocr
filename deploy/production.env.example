# Non-secret configuration. Inject the real values through the deployment secret manager.
DATABASE_URL_BOOTSTRAP=postgresql://bootstrap_user:REDACTED@db-host:5432/innovera_ocr
OCR_MIGRATOR_PASSWORD=REDACTED
DATABASE_URL_MIGRATOR=postgresql://ocr_migrator:REDACTED@db-host:5432/innovera_ocr
DATABASE_URL_APP=postgresql://ocr_app:REDACTED@db-host:5432/innovera_ocr
DATABASE_URL_WORKER=postgresql://ocr_worker:REDACTED@db-host:5432/innovera_ocr
DATABASE_URL_QUEUE=postgresql://ocr_queue:REDACTED@db-host:5432/innovera_ocr
AUTH_JWT_SECRETS=REDACTED_CURRENT,REDACTED_PREVIOUS
AUTH_JWT_ISSUER=https://auth.example.invalid/
AUTH_JWT_AUDIENCE=innovera-ocr
OCR_API_BASE_URL=https://ai.innoveraappcenter.com/ocr
OCR_REQUEST_TIMEOUT=300
OCR_MAX_RETRIES=3
OCR_MAX_PDF_PAGES=300
OCR_PAGE_FORMAT=png
OCR_CLAMAV_HOST=clamav
OCR_CLAMAV_PORT=3310
OCR_STORAGE_ROOT=/var/lib/ocr
OCR_CLEANUP_DRY_RUN=0
OCR_CLEANUP_LOCK_DIR=/var/run/innovera-ocr-cleanup.lock
OCR_CLEANUP_LOG=/var/log/innovera-ocr-cleanup.log
# Release 2 (login). Key names only; the host file holds the values.
OCR_WEB_TENANT_ID=
OCR_PUBLIC_BASE_URL=
OCR_TRUSTED_PROXY_HOPS=
OCR_SESSION_IDLE_MINUTES=
OCR_SESSION_ABSOLUTE_HOURS=
OCR_EXPORT_MAX_ROWS=
