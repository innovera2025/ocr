FROM node:24.21.0-bookworm-slim
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json tsconfig.json eslint.config.mjs ./
COPY apps ./apps
COPY packages ./packages
COPY services ./services
COPY prisma ./prisma
RUN corepack enable && pnpm install --frozen-lockfile
EXPOSE 3100
CMD ["pnpm", "--filter", "@innovera/ocr-web", "start"]
