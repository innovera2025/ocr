FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    torch \
    torchvision \
    transformers \
    pillow \
    sentencepiece \
    accelerate \
    safetensors

WORKDIR /app

CMD ["python"]
